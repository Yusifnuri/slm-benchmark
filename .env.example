# Copy this file to `.env` in the repository root and fill in your own keys.
# `.env` is gitignored and is never committed — if you re-clone the repository,
# you have to recreate it, and the providers do not re-display a key after
# creation, so a lost key means issuing a new one.
#
# These three are the ONLY environment variables the code reads. They are
# needed by the Phase 1 baseline notebooks (notebooks/02-06), which call the
# provider APIs directly.

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOT needed here: a HuggingFace token. Llama-3.2-3B is a gated repository, so
# downloading it requires authentication, but that is handled by
# `huggingface-cli login` (which writes to ~/.cache/huggingface/), not by this
# file — and it is only required for the Phase 2 GPU work, not for the API
# baselines above.
